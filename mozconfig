# Portable Firefox build (Option A: disable system-level policies).
# NOTE: verify --disable-system-policies exists in your tree
#   (grep -rn "policies" build/moz.configure browser/moz.configure).
# If it does not, use Option B from the README.

# Must be a full build, not --enable-artifact-builds.
ac_add_options --disable-system-policies

ac_add_options --enable-release
ac_add_options --disable-updater
ac_add_options --disable-maintenance-service
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-portable
